# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage/
coverage.xml
.nyc_output/
node_modules/

# Logs and local runtime files
*.log
*.pid

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Documentacion interna, entregables y pruebas solo locales
/docs/
/entregables/
/tests/

# Documentos y capturas de trabajo
*.doc
*.docx
*.pdf
*.xls
*.xlsx
*.ppt
*.pptx
~$*

# Archivos temporales, respaldos y salidas locales
*.tmp
*.bak
/tmp/
/temp/
/output/
/outputs/
/backups/
/respaldos/
